{
  "name": "deltav",
  "author": "DeltaV",
  "version": "0.1.0-alpha.7",
  "private": true,
  "type": "module",
  "main": "scripts/electron-main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "version:bump": "node scripts/bump-build-version.mjs",
    "test": "vitest run",
    "test:tutorial:entry": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/tutorial-entry.spec.ts",
    "test:tutorial:interactions": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/tutorial-interactions.spec.ts",
    "test:tutorial:recovery": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/tutorial-mandatory-launch-recovery.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"vite.config.ts\" && prettier --check \"AGENTS.md\" \"README.md\" \"docs/**/*.md\" \"index.html\" \"package.json\" \"tsconfig.json\" \"vite.config.ts\" \"eslint.config.js\" \"scripts/**/*.mjs\" \"src/**/*.{ts,css}\" \"tests/**/*.ts\"",
    "build": "vite build",
    "audit:balance-seeds": "node scripts/audit-balance-seeds.mjs",
    "verify": "npm test -- --no-file-parallelism --testTimeout=30000 && npm run typecheck && npm run lint && npm run build",
    "release:portable": "npm run verify && node scripts/package-portable.mjs",
    "icon:mac": "node scripts/generate-mac-icon.mjs",
    "icon:win": "node scripts/generate-mac-icon.mjs",
    "package:mac": "npm run icon:mac && node scripts/package-mac.mjs",
    "package:win": "npm run icon:win && node scripts/package-windows.mjs",
    "release:mac": "npm run verify && npm run package:mac",
    "release:win": "npm run verify && npm run package:win"
  },
  "dependencies": {
    "three": "^0.184.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.3",
    "@playwright/test": "^1.61.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/three": "^0.184.1",
    "archiver": "^8.0.0",
    "electron": "^43.1.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.6"
  }
}
